# cm4_bin2header.cmake — turn a raw binary into a C header holding a uint32_t
# array, in pure CMake (no python), so teensy_add_cm4_image stays dependency-free.
#
# Invoked as a script:
#   cmake -DBIN=<in.bin> -DNAME=<array> -DOUT=<out.h> -P cm4_bin2header.cmake
#
# Emits `static const uint32_t <NAME>[] = { ... };` from the little-endian
# 32-bit words of BIN (zero-padded up to a word boundary), matching
# int.from_bytes(chunk, "little").

file(READ "${BIN}" _hex HEX)                # lowercase hex, 2 chars per byte
string(LENGTH "${_hex}" _nchars)

# Pad up to a multiple of 8 hex chars (= 4 bytes / one word).
math(EXPR _rem "${_nchars} % 8")
if(_rem)
    math(EXPR _pad "8 - ${_rem}")
    foreach(_i RANGE 1 ${_pad})
        string(APPEND _hex "0")
    endforeach()
    string(LENGTH "${_hex}" _nchars)
endif()

set(_body "")
set(_col 0)
set(_pos 0)
while(_pos LESS _nchars)
    string(SUBSTRING "${_hex}" ${_pos} 2 _b0)
    math(EXPR _p "${_pos} + 2")
    string(SUBSTRING "${_hex}" ${_p} 2 _b1)
    math(EXPR _p "${_pos} + 4")
    string(SUBSTRING "${_hex}" ${_p} 2 _b2)
    math(EXPR _p "${_pos} + 6")
    string(SUBSTRING "${_hex}" ${_p} 2 _b3)
    # byte 0 is the least significant (little-endian).
    string(APPEND _body "0x${_b3}${_b2}${_b1}${_b0}, ")
    math(EXPR _col "${_col} + 1")
    if(_col EQUAL 4)
        string(APPEND _body "\n    ")
        set(_col 0)
    endif()
    math(EXPR _pos "${_pos} + 8")
endwhile()

file(WRITE "${OUT}"
"/* AUTO-GENERATED by teensy_add_cm4_image (cm4_bin2header.cmake).
 * Do not edit; rebuild the CM4 sources instead. */
#ifndef ${NAME}_h
#define ${NAME}_h
#include <stdint.h>
static const uint32_t ${NAME}[] = {
    ${_body}
};
#endif
")
